{
    "name": "purplespider/silverstripe-page-type-status-checker",
    "description": "A Silverstripe BuildTask that checks page type status by verifying HTTP status codes for CMS and frontend links",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "testing",
        "page-types",
        "build-task",
        "upgrade"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Purple Spider",
            "homepage": "https://purplespider.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silverstripe/admin": "^3.0",
        "silverstripe/versioned": "^3.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "Adds a Block Types table, checking each block type in the CMS and on the frontend"
    },
    "autoload": {
        "psr-4": {
            "PurpleSpider\\PageTypeTester\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    }
}
